# A whole song, with most of the vocabulary in it.
#
# Eight parts over six sections, on 丸サ進行.
#
#   auris compose examples/neon-drive.asong --print     # the specification, filled in
#   auris compose examples/neon-drive.asong -o neon.auris
#
# The syntax is TOML. Change one line and hear what it does — `seed` is the most rewarding:
# everything below is a pure function of this document and that number, so a different seed is a
# different take of the same song rather than a different song.

title  = "Neon Drive"
key    = "C minor"
scale  = "aeolian"
tempo  = 124
meter  = "4/4"
seed   = 7

# The four dials behind `mood`. Naming a feeling — `mood = "driving"`, or bright, dark, calm —
# sets all four at once; writing them out is how you get somewhere between two feelings.
brightness  = 0.35
energy      = 0.80
tension     = 0.55
syncopation = 0.45

groove   = "four-on-the-floor"
swing    = 54
humanize = 0.30
dynamics = 0.90
fill     = 0.60
# How much a second chorus departs from the first. At 0 it is note for note; the default leaves
# most of the material alone and rewrites the occasional bar.
variation = 0.30

chords = "@marusa"
form   = ["intro", "verse", "chorus", "verse", "chorus", "outro"]

# ------------------------------------------------------------------ sections
# A table keyed by name, because the order sections are written in means nothing: `form` above is
# what decides when each one plays.
#
# `intensity` is how hard the section is played. Every section name carries a default — a chorus
# is 0.90 and an intro 0.30 — so these lines are here to be tuned, not required.

[section.intro]
bars      = 4
intensity = 0.30
# Which parts play. Everything else sits the intro out, which is what makes the verse an
# entrance rather than a continuation.
parts = "pad bass hat"

[section.verse]
bars      = 8
intensity = 0.55
parts     = "lead chords bass kick snare hat"

[section.chorus]
bars      = 8
intensity = 0.95
# A tempo of its own, in force from this section's first bar until something changes it back. A
# step and not a slope: a section is a stretch of bars rather than a moment, so a ritardando —
# which slows *through* a passage — is not something this can say.
tempo     = 132
# `transpose` would move this section by a number of semitones — but it belongs to the *section*,
# and both choruses are the same section, so it would move both. A last chorus a tone higher than
# the first needs a section of its own today, which then gets figures of its own because material
# is keyed by the label. Modulating a repeat is on the list. The tempo above has the same shape:
# both choruses lift, because they are one chorus played twice.
#
# A section that *does* change key is led into: the last chord of whatever precedes it becomes the
# dominant seventh of the key being arrived at, so the ear is already there when the section
# starts. It is the one thing in this format that rewrites a bar of a progression quoted by name,
# and `lead_in = "none"` is how to say the plain jump was meant.

[section.outro]
bars      = 4
intensity = 0.25
parts     = "pad bass"

# ------------------------------------------------------------------ parts
# An array of tables rather than a table, because *this* order does mean something: it is the
# order the tracks are created in, and a table would sort `bass` above `lead`.
#
# A part's name implies its role, so the bass needs no `role` line. Everything a role implies —
# its register, its level, how long it holds a note — is a default the part is free to override.
#
# `octave` is the **absolute** octave the part sits in, not an offset: a melody's default is 5, so
# writing 6 moves it up one and writing 1 moves it down four. (The octave dial on a *clip* is the
# other thing — that one is ±2 from wherever its preset sits.) Left out here, because the
# registers the roles come with already keep the parts out of each other's way.

[[part]]
name       = "lead"
instrument = "auris.synth.chiptune"
density    = 0.55
gate       = 0.85

[[part]]
name        = "chords"
role        = "chords"
instrument  = "auris.synth.fm2"
subdivision = "8"
density     = 0.45

[[part]]
name       = "pad"
role       = "pad"
instrument = "auris.synth.fm2"

[[part]]
name        = "arp"
role        = "arp"
instrument  = "auris.synth.chiptune"
subdivision = "16"
density     = 0.75

[[part]]
name       = "bass"
instrument = "auris.synth.fm2"

[[part]]
name       = "kick"
instrument = "auris.synth.noisedrum"

[[part]]
name       = "snare"
instrument = "auris.synth.noisedrum"

[[part]]
name       = "hat"
instrument = "auris.synth.noisedrum"
density    = 0.65
