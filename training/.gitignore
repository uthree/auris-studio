# The virtual environment, and the caches the tools keep beside it.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# What training produces. A corpus is tens of gigabytes and a run's checkpoints hundreds of
# megabytes; the configs under `configs/` are what is version-controlled instead, and they say
# where a dataset was fetched from and how it was prepared.
data/
runs/
