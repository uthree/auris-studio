# The virtual environment, and the caches the tools keep beside it.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# What training produces. A corpus is tens of gigabytes and a run's checkpoints hundreds of
# megabytes; the configs under `configs/` are what is version-controlled instead, and they say
# where a dataset was fetched from and how it was prepared.
data/
runs/

# No lock file, on purpose. It would record whichever PyTorch index the machine that wrote it
# detected — the CUDA build on the one that trains — and hand that answer to every other machine.
# `--torch-backend=auto` is what resolves it instead; `doc/development.md` has the account.
uv.lock
